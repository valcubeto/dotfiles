{
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.acceptSuggestionOnEnter": "off",
  "editor.bracketPairColorization.enabled": false,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.fontFamily": "'jetbrains mono nl', '0xproto nerd font', 'victor mono', 'roboto mono', monospace",
  "editor.fontLigatures": false,
  "editor.fontSize": 23,
  "editor.fontWeight": 400,
  "scm.compactFolders": false,
  "explorer.compactFolders": false,
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/target": true,
    "**/.git": true,
  },
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "keyword.async": "#ff3c8d",
      "keyword.constant": "#2cdfff",
    }
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment, keyword, storage, string, entity.name.function, variable.language",
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "scope": "string, string.regexp",
        "settings": {
          "foreground": "#ffe554",
        }
      },
      // {
      //   "scope": "keyword.other, storage, storage.type",
      //   "settings": {
      //     "fontStyle": "italic",
      //     "foreground": "#2cdfff"
      //   }
      // },
      {
        "scope": "entity.name, entity.name.namespace, storage.modifier, storage.type",
        "settings": {
          "fontStyle": "italic",
          "foreground": "#2cdfff"
        }
      },
      {
        "scope": "keyword.other, meta, keyword.operator, keyword.control, keyword.generator, storage.modifier.async, keyword.hard",
        "settings": {
          "foreground": "#ff3c8d",
        },
      },
      {
        "scope": "entity.name.function, support.function, meta.method.declaration",
        "settings": {
          "foreground": "#a1ff6a"
        }
      },
      {
        "scope": "support.type.property-name.json, entity.name.type, support, variable.other.enummember",
        "settings": {
          "foreground": "#79a4ff",
          "fontStyle": "italic"
        }
      },
      {
        "scope": "keyword.operator",
        "settings": {
          "fontStyle": ""
        }
      },
      {
        "scope": "variable.other.constant, constant",
        "settings": {
          "foreground": "#dadada",
          "fontStyle": "bold"
        }
      },
      {
        "scope": "constant.language, constant.character, variable.language, variable.parameter.function.language.special.self",
        "settings": {
          "foreground": "#b057eb",
          "fontStyle": "italic"
        }
      },
      {
        "scope": "constant.numeric",
        "settings": {
          "foreground": "#b057eb",
          "fontStyle": ""
        }
      },
      {
        "scope": "source, variable, meta",
        "settings": {
          "foreground": "#dadada",
        }
      },
      {
        "scope": "variable.parameter",
        "settings": {
          "foreground": "#ffa939"
        }
      }
    ],
  },
  "editor.guides.indentation": false,
  "editor.insertSpaces": true,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.stickyTabStops": true,
  "editor.tabSize": 4,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.incrementalNaming": "simple",
  "extensions.ignoreRecommendations": true,
  "files.associations": {
    "Cargo.lock": "toml",
    "*.vega": "kotlin"
  },
  "files.defaultLanguage": "${activeEditorLanguage}",
  "files.eol": "\n",
  "files.exclude": {
    "**/.git": false
  },
  "files.readonlyInclude": {
    "**/.cargo/registry/src/**/*.rs": true,
    "**/.cargo/git/checkouts/**/*.rs": true,
    "**/lib/rustlib/src/rust/library/**/*.rs": true,
  },
  "window.commandCenter": true,
  "window.customTitleBarVisibility": "auto",
  "window.menuBarVisibility": "compact",
  "window.title": "${rootPath}",
  "window.titleBarStyle": "custom",
  "workbench.activityBar.location": "bottom",
  "workbench.editor.untitled.labelFormat": "name",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.iconTheme": "bearded-icons",
  "workbench.navigationControl.enabled": false,
  "workbench.sideBar.location": "right",
  "workbench.statusBar.visible": true,
  "scm.inputFontFamily": "editor",
  "security.workspace.trust.untrustedFiles": "open",

  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.fontSize": 20,
  "terminal.integrated.fontWeightBold": 600,

  "git.enabled": true,
  "editor.hover.delay": 1000,

  "highlight-bad-chars.allowedUnicodeChars": ["¿", "¡", "ñ", "Ñ"],

//  "rust-analyzer.cargo.allTargets": true,
  "rust-analyzer.cargo.autoreload": true,
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.imports.prefix": "crate",
  "rust-analyzer.lens.enable": false,
  "rust-analyzer.inlayHints.closingBraceHints.enable": false,
  "rust-analyzer.inlayHints.chainingHints.enable": false,
  "rust-analyzer.inlayHints.parameterHints.enable": false,
  "rust-analyzer.inlayHints.typeHints.enable": false,
  "rust-analyzer.showUnlinkedFileNotification": false,

  "todohighlight.isEnable": true,
  "todohighlight.maxFilesForSearch": 100,
  "todohighlight.include": [
    "**/*.js",
    "**/*.jsx",
    "**/*.ts",
    "**/*.tsx",
    "**/*.html",
    "**/*.css",
    "**/*.scss",
    "**/*.php",
    "**/*.txt",
    "**/*.md",
    "**/*.json"
  ],
  "todohighlight.defaultStyle": {
    "color": "cyan",
    "backgroundColor": "rgb(255, 255, 255, 0.3)",
  },
  "todohighlight.keywords": [
    "todo!",
    {
      "text": "TODO:",
      "color": "cyan",
      "backgroundColor": "rgb(255, 255, 255, 0.3)"
    },
    {
      "text": "FIXME:",
      "color": "white",
      "backgroundColor": "rgb(255, 80, 80, 0.5)"
    },
  ],

	"npm.packageManager": "bun",
  "bun.runtime": "/home/guady/.bun/bin/bun",
  "js/ts.tsserver.npm.path": "/home/guady/.bun/bin/bun",
  "js/ts.tsserver.node.path": "/home/guady/.bun/bin/bun",
  "js/ts.inlayHints.parameterTypes.enabled": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",

  "vscord.app.name": "VSCodium",
  "vscord.status.details.text.notInFile": "Somewhere in {workspace}",
  "vscord.status.details.text.editing": "Editing {file_name}{file_extension}:{current_line}:{current_column}",
  "vscord.status.details.text.idle":    "Viewing {file_name}{file_extension}",
  "vscord.status.details.text.viewing": "Viewing {file_name}{file_extension}",
  "vscord.status.state.text.editing": "{problems_count_errors} errors, {problems_count_warnings} warnings.",
  "vscord.status.state.text.idle":    "{problems_count_errors} errors, {problems_count_warnings} warnings.",
  "vscord.status.state.text.viewing": "{problems_count_errors} errors, {problems_count_warnings} warnings.",
  "vscord.status.details.text.noWorkSpaceText": "Not in a workspace",
  "vscord.status.state.text.noWorkspaceFound": "Not in a workspace",

  "update.showReleaseNotes": false,
  "extensions.autoUpdate": "onlyEnabledExtensions",
  "update.enableWindowsBackgroundUpdates": false,
  "update.mode": "manual",
  "workbench.editor.empty.hint": "hidden",
  "workbench.colorTheme": "GitHub Dark Colorblind (Beta)",
  "git.openRepositoryInParentFolders": "never",
  "editor.unicodeHighlight.nonBasicASCII": false,
  "python.defaultInterpreterPath": "/usr/bin/python3",
  "kotlin.languageServer.enabled": false,
  "kotlin.indexing.enabled": false,
}